direction: right
vars: { d2-config: { layout-engine: elk; theme-id: 1 } }
classes: {
  claude: { style: { fill: "#f3e8ff"; stroke: "#7c3aed"; font-color: "#3b0764"; border-radius: 8 } }
  code:   { style: { fill: "#ffffff"; stroke: "#444444"; border-radius: 8 } }
  data:   { style: { fill: "#f4f4f2"; stroke: "#888888"; border-radius: 8 } }
  human:  { style: { fill: "#fff4d6"; stroke: "#b45309"; border-radius: 8 } }
}

calm: 平時（あらかじめ） {
  style: { fill: "#fafafa"; stroke: "#bbbbbb"; stroke-dash: 3; font-size: 18 }
  pdf: 自治体のハザードマップ PDF { class: data }
  gsi: 国土地理院 避難場所データ { class: data }
  site: 画面の緯度経度・向き { class: data }
  reader: Reader（Claude）\n出典ページつきで読む { class: claude }
  muni: municipality.json { class: data }
  pdf -> reader
  gsi -> reader
  site -> reader
  reader -> muni
}

crisis: 有事（電文が届いたら） {
  style: { fill: "#fafafa"; stroke: "#bbbbbb"; stroke-dash: 3; font-size: 18 }
  jma: 気象庁 防災情報 XML { class: data }
  parser: parser → 警報・レベル・地域 { class: code }
  writer: Writer（Claude）\nやさしい日本語・英中韓 { class: claude }
  composer: Composer\n最寄り避難場所・方向・距離 { class: code }
  layout: layout JSON × 5 形状 { class: data }
  renderer: Renderer（Nuxt・決定論） { class: code }
  verifier: Verifier\n規則・ブラウザ DOM・Vision（Claude） { class: claude }
  jma -> parser -> writer -> composer -> layout -> renderer -> verifier
  verifier -> writer: 指摘を差し戻す { style: { stroke-dash: 4 } }
}
calm.muni -> crisis.composer

approve: 運営者が平時に承認 { class: human }
crisis.verifier -> approve: 検査 pass
deliver: イベント発火\nfeed / 署名つき webhook / 静的ファイル { class: code }
approve -> deliver: 承認済みだけ
screens: どのサイネージでも { class: data }
deliver -> screens: alert / clear
