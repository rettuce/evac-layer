{
  "name": "app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1 --port 3150",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview --host 127.0.0.1 --port 3150",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare",
    "test": "nuxt build && node --test test/*.test.ts",
    "screens": "nuxt build && node ../scripts/screens.mjs",
    "coverage": "nuxt build && node ../scripts/coverage.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.1",
    "@fontsource/noto-sans-kr": "^5.2.0",
    "@fontsource/noto-sans-sc": "^5.2.0",
    "@fontsource/noto-sans-tc": "^5.2.0",
    "@fontsource/noto-sans-thai": "^5.3.0",
    "nuxt": "^4.6.3",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "puppeteer-core": "^25.0.0",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.0.0"
  }
}
