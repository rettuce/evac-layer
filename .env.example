ANTHROPIC_API_KEY=

# Where the repository's data lives (sites, layouts, approvals, live state). Shared by agents and app.
EVAC_DATA_DIR=data
# Raw inputs that are not redistributed: GSI shelter CSV, municipal hazard-map PDFs, JMA sample bulletins.
EVAC_RAW_DIR=data/raw
# Recorded JMA long-term feed (bodies/<date>/*.xml). Defaults to $EVAC_RAW_DIR/jma-feed.
# JMA_FEED_DIR=
# The running app that export and the browser Verifier talk to.
EVAC_URL=http://127.0.0.1:3150
# Chrome or Chromium for export and checks. Empty: the usual macOS and Linux locations are tried.
# CHROME_PATH=
