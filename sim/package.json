{
  "name": "evac-layer-sim",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3160",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3160",
    "export-glb": "blender -b -P blender/export_glb.py",
    "fetch-ambient": "gh release download ambient-loops-v1 --repo rettuce/evac-layer --pattern '*.mp4' -D public/ambient --clobber"
  },
  "dependencies": {
    "animejs": "^4.5.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  }
}
